[credential]
	helper = libsecret
	useHttpPath = true
	credentialStore = secretservice
[user]
	name = Artem Vovchenko
[include]
	path = ~/.gitconfig-work
[init]
	defaultBranch = main
[http]
	postBuffer = 157286400
[pull]
	rebase = false
[core]
	autocrlf = false
	pager = delta
[safe]
	directory = *
[interactive]
	diffFilter = delta --color-only --features=diff-so-fancy
[delta]
	navigate = true
	line-numbers = true
[credential "https://dev.azure.com"]
	helper =
	helper = manager
	azreposCredentialType = oauth
	useHttpPath = true
